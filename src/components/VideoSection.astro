---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import projectsShot from "../assets/screenshots/projects.png";

interface Props {
	image?: ImageMetadata;
	embedSrc?: string;
}

const {
	image = projectsShot,
	embedSrc = "https://www.youtube.com/embed/aqz-KE-bpKQ?autoplay=1&rel=0",
} = Astro.props;
---

<section id="video" aria-label="Product video">
	<button type="button" class="video-teaser" data-video-open>
		<Image
			class="video-teaser-image"
			src={image}
			alt=""
			widths={[640, 960, 1280]}
			sizes="(max-width: 960px) 100vw, 960px"
			quality={70}
		/>
		<span class="video-play-btn cta cta-blue">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path fill="currentColor" d="M8 5.14v13.72L19 12 8 5.14z"></path>
			</svg>
			<span>Play this 2-minute video</span>
		</span>
	</button>
</section>

<dialog class="video-modal" data-video-modal aria-label="Product video">
	<div class="video-modal-panel">
		<button type="button" class="video-modal-close" data-video-close aria-label="Close video">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none">
				<path
					d="M7 7l10 10M17 7L7 17"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
				></path>
			</svg>
		</button>
		<div class="video-modal-frame">
			<iframe
				data-video-frame
				title="Project Binder product video"
				src=""
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				allowfullscreen
				referrerpolicy="strict-origin-when-cross-origin"
			></iframe>
		</div>
	</div>
</dialog>

<script define:vars={{ embedSrc }}>
	const videoModal = document.querySelector("[data-video-modal]");
	const videoOpen = document.querySelector("[data-video-open]");
	const videoClose = document.querySelector("[data-video-close]");
	const videoFrame = document.querySelector("[data-video-frame]");
	const videoEmbedSrc = embedSrc;

	function closeVideoModal() {
		if (!(videoModal instanceof HTMLDialogElement)) return;
		if (videoFrame instanceof HTMLIFrameElement) {
			videoFrame.src = "";
		}
		videoModal.close();
		document.body.classList.remove("video-modal-open");
	}

	function openVideoModal() {
		if (!(videoModal instanceof HTMLDialogElement)) return;
		if (videoFrame instanceof HTMLIFrameElement) {
			videoFrame.src = videoEmbedSrc;
		}
		document.body.classList.add("video-modal-open");
		videoModal.showModal();
	}

	if (videoOpen instanceof HTMLButtonElement) {
		videoOpen.addEventListener("click", openVideoModal);
	}

	if (videoClose instanceof HTMLButtonElement) {
		videoClose.addEventListener("click", closeVideoModal);
	}

	if (videoModal instanceof HTMLDialogElement) {
		videoModal.addEventListener("click", (event) => {
			if (event.target === videoModal) closeVideoModal();
		});
		videoModal.addEventListener("close", () => {
			if (videoFrame instanceof HTMLIFrameElement) {
				videoFrame.src = "";
			}
			document.body.classList.remove("video-modal-open");
		});
	}
</script>
