---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Feedback - Project Binder">
	<section class="feedback">
		<h1>Feedback</h1>
		<div class="feedback-panel">
			<iframe
				data-tally-src="https://tally.so/embed/0Q2ZVy?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
				loading="lazy"
				width="100%"
				height="552"
				frameborder="0"
				marginheight="0"
				marginwidth="0"
				title="Project Binder feedback"
				class="tally-embed"
			></iframe>
		</div>
	</section>

	<script is:inline>
		var d = document,
			w = "https://tally.so/widgets/embed.js",
			v = function () {
				"undefined" != typeof Tally
					? Tally.loadEmbeds()
					: d
							.querySelectorAll("iframe[data-tally-src]:not([src])")
							.forEach(function (e) {
								e.src = e.dataset.tallySrc;
							});
			};
		if ("undefined" != typeof Tally) v();
		else if (d.querySelector('script[src="' + w + '"]') == null) {
			var s = d.createElement("script");
			s.src = w;
			s.onload = v;
			s.onerror = v;
			d.body.appendChild(s);
		}
	</script>
</Layout>

<style>
	.feedback h1 {
		margin-bottom: 1.5rem;
	}

	.feedback-panel {
		max-width: var(--max);
		margin-inline: auto;
		padding: 1.5rem 1.35rem 1.25rem;
		border-radius: calc(var(--radius) + 4px);
		background: #f5f5f7;
		border: 1px solid color-mix(in srgb, #fff 12%, transparent);
		box-shadow: 0 16px 40px color-mix(in srgb, #000 35%, transparent);
	}

	.tally-embed {
		display: block;
		width: 100%;
		border: 0;
		min-height: 552px;
	}
</style>
