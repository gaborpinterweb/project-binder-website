---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Feedback - Project Binder">
	<section class="feedback">
		<h1>Feedback</h1>
		<div class="feedback-panel">
			<iframe
				data-tally-src="https://tally.so/embed/0Q2ZVy?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
				loading="lazy"
				width="100%"
				height="552"
				frameborder="0"
				marginheight="0"
				marginwidth="0"
				title="Project Binder feedback"
				class="tally-embed"
			></iframe>
		</div>
	</section>

	<script>
		declare global {
			interface Window {
				Tally?: { loadEmbeds: () => void };
			}
		}

		const TALLY_SCRIPT = "https://tally.so/widgets/embed.js";

		function tallyFrames() {
			return document.querySelectorAll<HTMLIFrameElement>("iframe[data-tally-src]");
		}

		function fillTallyFrames() {
			tallyFrames().forEach((frame) => {
				const src = frame.dataset.tallySrc;
				if (!src) return;
				// Force a fresh load after client-side navigations.
				frame.removeAttribute("src");
				frame.src = src;
			});
		}

		function loadTallyScript(): Promise<void> {
			if (window.Tally) return Promise.resolve();

			const existing = document.querySelector<HTMLScriptElement>(`script[src="${TALLY_SCRIPT}"]`);
			if (existing) {
				return new Promise((resolve) => {
					if (window.Tally) {
						resolve();
						return;
					}
					let settled = false;
					const finish = () => {
						if (settled) return;
						settled = true;
						resolve();
					};
					existing.addEventListener("load", finish, { once: true });
					existing.addEventListener("error", finish, { once: true });
					// load may have already fired before we attached listeners
					window.setTimeout(finish, 100);
				});
			}

			return new Promise((resolve) => {
				const script = document.createElement("script");
				script.src = TALLY_SCRIPT;
				script.async = true;
				script.onload = () => resolve();
				script.onerror = () => resolve();
				document.body.appendChild(script);
			});
		}

		async function initTally() {
			if (!tallyFrames().length) return;

			await loadTallyScript();
			if (window.Tally) {
				// Ensure embeds are eligible for Tally.loadEmbeds().
				tallyFrames().forEach((frame) => frame.removeAttribute("src"));
				window.Tally.loadEmbeds();
			} else {
				fillTallyFrames();
			}
		}

		document.addEventListener("astro:page-load", () => {
			void initTally();
		});
	</script>
</Layout>

<style>
	.feedback h1 {
		margin-bottom: 1.5rem;
	}

	.feedback-panel {
		max-width: var(--max);
		margin-inline: auto;
		padding: 1.75rem 1.5rem 1.35rem;
		border-radius: calc(var(--radius) + 6px);
		background: #f5f5f7;
		border: 1px solid #d2d2d7;
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 70%, transparent),
			0 12px 28px color-mix(in srgb, #000 28%, transparent),
			0 32px 64px color-mix(in srgb, #000 35%, transparent);
		animation: feedback-card-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes feedback-card-in {
		from {
			opacity: 0;
			transform: translateY(0.85rem) scale(0.985);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feedback-panel {
			animation: none;
		}
	}

	.tally-embed {
		display: block;
		width: 100%;
		border: 0;
		min-height: 552px;
	}
</style>
