---
import Layout from "../layouts/Layout.astro";

const githubChangelog =
	"https://github.com/gaborpinterweb/project-binder/blob/main/CHANGELOG.md";
---

<Layout
	title="Changelog - Project Binder"
	description="Release notes and changes for Project Binder."
>
	<section class="legal changelog">
		<h1>Changelog</h1>
		<!--CHANGELOG_CONTENT-->
		<p class="changelog-fallback">
			A short history of what is new, fixed, or improved in each Project Binder
			release. This page is built on demand from the project's{" "}
			<a href={githubChangelog} target="_blank" rel="noopener noreferrer"
				>CHANGELOG.md</a
			>{" "}
			on GitHub.
		</p>
		<!--/CHANGELOG_CONTENT-->
	</section>
</Layout>
