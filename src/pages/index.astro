---
import Layout from "../layouts/Layout.astro";

const screenshots = [
	{ id: "projects", label: "Projects" },
	{ id: "tasks", label: "Tasks" },
	{ id: "timer", label: "Timer" },
	{ id: "notes", label: "Notes" },
	{ id: "files", label: "Files" },
	{ id: "database", label: "Database" },
];

const features = [
	"Is Project Binder free?",
	"Does it work offline?",
	"Can I manage tasks on a Kanban board?",
	"Can I use a timer, Pomodoro, and stopwatch?",
	"Can I keep notes per project?",
	"Can I store files with my projects?",
	"Is there a built-in database?",
	"Does it run on macOS and Windows?",
	"Can I log time against projects?",
	"Can freelancers run everything in one app?",
];
---

<Layout title="Project Binder — Free project management for freelancers">
	<section id="hero">
		<h1>
			Free project management for freelancers with tasks, timelogs, notes, files, database and
			more.
		</h1>
		<div class="hero-ctas">
			<a class="cta" href="#">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.22-2 1.08-3.15-1.05.05-2.31.72-3.05 1.6-.66.78-1.24 2.04-1.08 3.23 1.14.09 2.31-.58 3.05-1.68"
					></path>
				</svg>
				<span>Download for macOS</span>
			</a>
			<a class="cta" href="#">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M3 5.5 10.5 4.4v7.1H3Zm8.2-1.3L21 2.5v9H11.2Zm0 8.3H21V21.5l-9.8-1.4Zm-1.7.1v6.8L3 18.5v-5.9Z"
					></path>
				</svg>
				<span>Download for Windows</span>
			</a>
		</div>

		<div class="screenshot-gallery" data-gallery>
			<div class="screenshot-main">
				<button type="button" data-prev aria-label="Previous screenshot">←</button>
				<figure>
					<div class="screenshot-placeholder" data-main-label>Projects</div>
					<figcaption data-main-caption>Projects</figcaption>
				</figure>
				<button type="button" data-next aria-label="Next screenshot">→</button>
			</div>

			<ul class="screenshot-thumbs">
				{
					screenshots.map((shot, index) => (
						<li>
							<button
								type="button"
								data-thumb
								data-index={index}
								aria-current={index === 0 ? "true" : "false"}
							>
								<span class="thumb-placeholder">{shot.label}</span>
								<span>{shot.label}</span>
							</button>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id="learn">
		<h2>Learn</h2>
		<ul>
			<li>
				<div class="video-placeholder">Video placeholder 1</div>
				<p>Getting started with Project Binder</p>
			</li>
			<li>
				<div class="video-placeholder">Video placeholder 2</div>
				<p>Tasks and Kanban</p>
			</li>
			<li>
				<div class="video-placeholder">Video placeholder 3</div>
				<p>Timers and timelogs</p>
			</li>
		</ul>
		<p><a href="/learn">All videos</a></p>
	</section>

	<section id="features">
		<h2>With Project Binder, it’s a Yes!</h2>
		<p>
			Even though Project Binder is simple and easy to use, it’s also flexible. There’s so much you
			can do with it — and so much it can do for you.
		</p>
		<ul>
			{features.map((feature) => <li>{feature}</li>)}
		</ul>
	</section>

	<section id="about">
		<h2>About</h2>
		<p>
			From freelancer to freelancer. Hi, I'm Gábor and I made Project Binder for myself, but then.
		</p>
	</section>
</Layout>

<script>
	const labels = ["Projects", "Tasks", "Timer", "Notes", "Files", "Database"];
	const gallery = document.querySelector("[data-gallery]");
	if (gallery) {
		let current = 0;
		const mainLabel = gallery.querySelector("[data-main-label]");
		const mainCaption = gallery.querySelector("[data-main-caption]");
		const thumbs = gallery.querySelectorAll("[data-thumb]");

		function show(index: number) {
			current = (index + labels.length) % labels.length;
			if (mainLabel) mainLabel.textContent = labels[current];
			if (mainCaption) mainCaption.textContent = labels[current];
			thumbs.forEach((thumb, i) => {
				thumb.setAttribute("aria-current", i === current ? "true" : "false");
			});
		}

		gallery.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
		gallery.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
		thumbs.forEach((thumb) => {
			thumb.addEventListener("click", () => {
				const index = Number((thumb as HTMLElement).dataset.index);
				show(index);
			});
		});
	}
</script>
