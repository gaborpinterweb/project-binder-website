---
import { Image } from "astro:assets";
import { ArrowUpRight, BellRing } from "lucide";
import Layout from "../layouts/Layout.astro";
import { hugeIconHtml } from "../lib/hugeicon";
import projectsShot from "../assets/screenshots/projects.png";
import tasksShot from "../assets/screenshots/tasks.png";
import timelogsShot from "../assets/screenshots/timelogs.png";
import notesShot from "../assets/screenshots/notes.png";
import filesShot from "../assets/screenshots/files.png";
import databasesShot from "../assets/screenshots/databases.png";

const subscribeBellHtml = hugeIconHtml(BellRing);
const openAppArrowHtml = hugeIconHtml(ArrowUpRight);
const githubMarkPath =
	"M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 .1.7 1.6 2.7 1.1.1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3";

const screenshots = [
	{ id: "projects", label: "Projects", image: projectsShot },
	{ id: "tasks", label: "Tasks", image: tasksShot },
	{ id: "timelogs", label: "Timelogs", image: timelogsShot },
	{ id: "notes", label: "Notes", image: notesShot },
	{ id: "files", label: "Files", image: filesShot },
	{ id: "databases", label: "Databases", image: databasesShot },
];

const features = [
	"Is Project Binder open-source?",
	"Can I manage project tasks on a Kanban board?",
	"Can I manage all my tasks at once on a Master board?",
	"Can I track time using a stopwatch or countdown timer?",
	"Can I see my timelogs grouped by projects and date?",
	"Can I take notes and build a knowledge base?",
	"Can I use markdown and add tables and images to my notes?",
	"Can I add files to my tasks?",
	"Can I store files with my projects?",
	"Can I preview PDF, DOCX, XLSX, PPTX and other files?",
	"Can I create databases for my projects?",
	"Can I share a project with a client via a public link?",
	"Can I import / export / backup my data?",
];

const pricingRows = [
	{
		feature: "Active projects",
		tip: "How many projects you can keep active at once. Archive or delete a project to free up a slot.",
		freeCloud: "3",
		proCloud: "Unlimited",
		selfHosted: "Unlimited",
	},
	{
		feature: "Total file storage",
		tip: "The combined size of all your files, attachments, and data.",
		freeCloud: "200 MB",
		proCloud: "Unlimited",
		selfHosted: "Unlimited",
	},
	{
		feature: "Public read-only links",
		tip: "Share a tab or whole project with a link so clients can review it.",
		freeCloud: "0",
		proCloud: "Unlimited",
		selfHosted: "Unlimited",
	},
	{
		feature: "Who's it for",
		prose: true,
		freeCloud: "Beginner or part-time freelancers",
		proCloud: "Profesisonal, full-time freelancers",
		selfHosted: "Technical freelancers who want their own server",
	},
];
---

<Layout
	title="Project Binder - One binder for all your freelancing work"
	description="Project Binder is an open-source project management application with tasks, timelogs, notes, files and records."
>
	<section id="hero">
		<h1>One binder for all your freelancing work</h1>
		<p class="hero-lede">
			Project Binder is an open-source project management application<br />
			with tasks, time tracking, notes, files and databases.
		</p>
		<div class="hero-ctas">
			<a
				class="cta cta-blue"
				href="https://cloud.projectbinder.app"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					width="18"
					height="18"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					set:html={openAppArrowHtml}
				/>
				<span>Open cloud app</span>
			</a>
			<a
				class="cta cta-black"
				href="https://github.com/gaborpinterweb/project-binder"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
					<path fill="currentColor" d={githubMarkPath}></path>
				</svg>
				<span>Open on GitHub</span>
			</a>
		</div>

		<div class="screenshot-gallery" data-gallery>
			<div class="screenshot-main">
				{
					screenshots.map((shot, index) => (
						<figure
							class="screenshot-frame"
							data-main-shot
							data-index={index}
							hidden={index !== 0}
						>
							<Image
								src={shot.image}
								alt={`Project Binder - ${shot.label}`}
								widths={[640, 960, 1280, 1710]}
								sizes="(max-width: 960px) 100vw, 960px"
								quality={85}
							/>
						</figure>
					))
				}
			</div>

			<div class="screenshot-slider" data-slider tabindex="0" aria-label="App screenshots">
				{
					screenshots.map((shot, index) => (
						<figure class="screenshot-slide" data-slide data-index={index}>
							<div class="screenshot-frame">
								<Image
									src={shot.image}
									alt={`Project Binder - ${shot.label}`}
									widths={[480, 720, 960]}
									sizes="(max-width: 720px) 78vw, 480px"
									quality={85}
								/>
							</div>
							<figcaption>{shot.label}</figcaption>
						</figure>
					))
				}
			</div>

			<ul class="screenshot-thumbs">
				{
					screenshots.map((shot, index) => (
						<li>
							<button
								type="button"
								data-thumb
								data-index={index}
								aria-current={index === 0 ? "true" : "false"}
								aria-label={`Show ${shot.label} screenshot`}
							>
								<span class="thumb-frame">
									<Image
										src={shot.image}
										alt=""
										width={280}
										quality={70}
									/>
								</span>
								<span>{shot.label}</span>
							</button>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id="features">
		<h2>Features</h2>
		<ul>
			{
				features.map((feature) => (
					<li>
						<span class="feature-check" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="17" height="17" fill="none">
								<path
									d="M5 12.5l4.5 4.5L19 7"
									stroke="currentColor"
									stroke-width="3"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
						<div class="feature-entry">
							<strong class="feature-q">{feature}</strong>
							<span class="feature-dots" aria-hidden="true"></span>
							<span class="feature-yes">YES!</span>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section id="pricing">
		<h2>Pricing</h2>
		<div class="pricing-table-wrap">
			<table class="pricing-table">
				<colgroup>
					<col />
					<col />
					<col />
					<col />
				</colgroup>
				<thead>
					<tr>
						<th scope="col"></th>
						<th scope="col">
							<span class="pricing-plan">Cloud Free</span>
							<span class="pricing-tag">FREE FOREVER</span>
						</th>
						<th scope="col" class="pricing-col-pro">
							<span class="pricing-plan">Cloud Pro</span>
							<span class="pricing-tag pricing-tag-pro">$4.99/m or $49.99/y</span>
						</th>
						<th scope="col">
							<span class="pricing-plan">Self-host</span>
							<span class="pricing-tag">FREE FOREVER</span>
						</th>
					</tr>
				</thead>
				<tbody>
					{
						pricingRows.map((row) => (
							<tr class={row.prose ? "pricing-row-prose" : undefined}>
								<th scope="row">
									<span class="pricing-feature">
										{row.feature}
										{row.tip ? (
											<span class="pricing-tip">
												<button
													type="button"
													class="pricing-tip-btn"
													aria-label={`About ${row.feature}`}
												>
													i
												</button>
												<span class="pricing-tip-bubble" role="tooltip">
													{row.tip}
												</span>
											</span>
										) : null}
									</span>
								</th>
								<td>{row.freeCloud}</td>
								<td class="pricing-col-pro">{row.proCloud}</td>
								<td>{row.selfHosted}</td>
							</tr>
						))
					}
					<tr class="pricing-actions">
						<th scope="row"></th>
						<td>
							<a
								class="cta cta-blue pricing-cta"
								href="https://cloud.projectbinder.app"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
									width="16"
									height="16"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={openAppArrowHtml}
								/>
								Open cloud app
							</a>
						</td>
						<td class="pricing-col-pro">
							<a
								class="cta cta-blue pricing-cta"
								href="https://cloud.projectbinder.app"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
									width="16"
									height="16"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={openAppArrowHtml}
								/>
								Open cloud app
							</a>
						</td>
						<td>
							<a
								class="cta cta-black pricing-cta"
								href="https://github.com/gaborpinterweb/project-binder"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
									<path fill="currentColor" d={githubMarkPath}></path>
								</svg>
								Open on GitHub
							</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>

	<section id="final-cta">
		<h2>Project Binder news</h2>
		<p class="newsletter-desc">
			Get Project Binder news, tips and release notes.<br />
			No spam ever. Unsubscribe anytime.
		</p>
		<form class="newsletter-form" action="/api/subscribe" method="post" data-newsletter-form>
			<label class="newsletter-honeypot" aria-hidden="true">
				Company
				<input
					type="text"
					name="company"
					tabindex="-1"
					autocomplete="off"
				/>
			</label>
			<input
				id="newsletter-email"
				type="email"
				name="email"
				required
				placeholder="Your email address..."
				autocomplete="email"
				aria-label="Email"
			/>
			<button type="submit">
				<svg
					class="newsletter-submit-icon"
					viewBox="0 0 24 24"
					width="18"
					height="18"
					aria-hidden="true"
					fill="currentColor"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					set:html={subscribeBellHtml}
				/>
				Subscribe
			</button>
			<p class="newsletter-status" data-newsletter-status role="status" aria-live="polite" hidden></p>
		</form>
	</section>
</Layout>

<script>
	const newsletterForm = document.querySelector("[data-newsletter-form]");
	if (newsletterForm instanceof HTMLFormElement) {
		const status = newsletterForm.querySelector("[data-newsletter-status]");
		const submitButton = newsletterForm.querySelector('button[type="submit"]');

		function setStatus(message: string, kind: "ok" | "error" | "info") {
			if (!(status instanceof HTMLElement)) return;
			status.hidden = !message;
			status.textContent = message;
			status.dataset.kind = kind;
		}

		const params = new URLSearchParams(window.location.search);
		const newsletterState = params.get("newsletter");
		if (newsletterState === "confirmed") {
			setStatus("You're subscribed. Thanks for joining.", "ok");
			params.delete("newsletter");
			const next = `${window.location.pathname}${params.toString() ? `?${params}` : ""}${window.location.hash}`;
			window.history.replaceState({}, "", next);
		} else if (newsletterState === "invalid") {
			setStatus("That confirmation link is invalid or expired. Subscribe again.", "error");
			params.delete("newsletter");
			const next = `${window.location.pathname}${params.toString() ? `?${params}` : ""}${window.location.hash}`;
			window.history.replaceState({}, "", next);
		}

		newsletterForm.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
			}
			setStatus("Sending confirmation…", "info");

			try {
				const response = await fetch("/api/subscribe", {
					method: "POST",
					body: new FormData(newsletterForm),
					headers: { Accept: "application/json" },
				});
				const result = (await response.json()) as { ok?: boolean; message?: string; error?: string };
				if (!response.ok || !result.ok) {
					setStatus(result.error ?? "Something went wrong. Try again.", "error");
					return;
				}
				setStatus(result.message ?? "Check your email to confirm", "ok");
				newsletterForm.reset();
			} catch {
				setStatus("Something went wrong. Try again.", "error");
			} finally {
				if (submitButton instanceof HTMLButtonElement) {
					submitButton.disabled = false;
				}
			}
		});
	}

	const gallery = document.querySelector("[data-gallery]");
	if (gallery) {
		const shots = gallery.querySelectorAll("[data-main-shot]");
		const thumbs = gallery.querySelectorAll("[data-thumb]");
		const slider = gallery.querySelector("[data-slider]");
		const slides = gallery.querySelectorAll("[data-slide]");
		const count = shots.length;

		function show(index: number) {
			const current = ((index % count) + count) % count;
			shots.forEach((shot, i) => {
				(shot as HTMLElement).hidden = i !== current;
			});
			thumbs.forEach((thumb, i) => {
				thumb.setAttribute("aria-current", i === current ? "true" : "false");
			});
			slides.forEach((slide, i) => {
				slide.classList.toggle("is-active", i === current);
			});
		}

		thumbs.forEach((thumb) => {
			thumb.addEventListener("click", () => {
				const index = Number((thumb as HTMLElement).dataset.index);
				show(index);
			});
		});

		if (slider instanceof HTMLElement && slides.length > 0) {
			const syncFromScroll = () => {
				const sliderRect = slider.getBoundingClientRect();
				const center = sliderRect.left + sliderRect.width / 2;
				let nearest = 0;
				let nearestDist = Infinity;
				slides.forEach((slide, i) => {
					const rect = (slide as HTMLElement).getBoundingClientRect();
					const dist = Math.abs(rect.left + rect.width / 2 - center);
					if (dist < nearestDist) {
						nearestDist = dist;
						nearest = i;
					}
				});
				show(nearest);
			};

			slider.addEventListener("scroll", () => {
				window.requestAnimationFrame(syncFromScroll);
			}, { passive: true });

			show(0);
		}
	}

	document.querySelectorAll(".pricing-tip").forEach((tip) => {
		const button = tip.querySelector(".pricing-tip-btn");
		if (!(button instanceof HTMLButtonElement)) return;

		button.addEventListener("click", (event) => {
			event.stopPropagation();
			const willOpen = !tip.classList.contains("is-open");
			document.querySelectorAll(".pricing-tip.is-open").forEach((other) => {
				other.classList.remove("is-open");
			});
			tip.classList.toggle("is-open", willOpen);
		});
	});

	document.addEventListener("click", () => {
		document.querySelectorAll(".pricing-tip.is-open").forEach((tip) => {
			tip.classList.remove("is-open");
		});
	});

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		document.querySelectorAll(".pricing-tip.is-open").forEach((tip) => {
			tip.classList.remove("is-open");
		});
	});
</script>
